rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Users may only ever move money between their own balance and a
      // counterparty's balance changing by the exact opposite amount, and
      // may never touch frozen/accountNumber/email themselves.
      allow create: if isOwner(uid);
      allow update: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.frozen == resource.data.frozen &&
        request.resource.data.accountNumber == resource.data.accountNumber &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.balance <= resource.data.balance // sender leg only
      ) || (
        isSignedIn() &&
        // receiver leg of a transfer: only balance may increase
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance']) &&
        request.resource.data.balance > resource.data.balance
      );
      allow delete: if false;
    }

    match /transactions/{txId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.participants);
      allow create: if isAdmin() || (isSignedIn() && request.auth.uid in request.resource.data.participants);
      allow update, delete: if false;
    }

    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false; // manage via Firebase console only
    }
  }
}
